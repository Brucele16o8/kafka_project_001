# ==============================
# TARGET KAFKA B - 3-BROKER
# ==============================
TARGET_KAFKA_BOOTSTRAP_SERVERS=localhost:9094,localhost:9194,localhost:9294
TARGET_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
TARGET_KAFKA_SASL_MECHANISM=PLAIN
TARGET_KAFKA_USERNAME=kafka
TARGET_KAFKA_PASSWORD=local-kafka-password
TARGET_TOPIC=product_view_local
TARGET_DLQ_TOPIC=product_view_local_dlq
TARGET_TOPIC_PARTITIONS=3
TARGET_TOPIC_REPLICATION_FACTOR=3
SINK_GROUP_ID=product-view-mongo-sink
SINK_AUTO_OFFSET_RESET=earliest

# auto = JSON when possible, otherwise preserve as text/binary
# json = require JSON; invalid payload goes to DLQ
# raw  = never decode; preserve bytes
SINK_VALUE_FORMAT=auto

# ===============================
# AKHQ LOCAL UI CREDENTIALS
# ===============================
AKHQ_USERNAME=admin
# SHA-256 of the local password "admin"
AKHQ_PASSWORD_SHA256=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
AKHQ_JWT_SECRET=local-dev-jwt-secret-change-me-0123456789abcdef

# =================================
# MONGODB - LOCAL DOCKER
# =================================
MONGO_ROOT_USERNAME=root_admin
MONGO_ROOT_PASSWORD=local-root-password
MONGO_APP_USERNAME=kafka_app
MONGO_APP_PASSWORD=local-app-password
MONGO_DATABASE=kafka_db
MONGO_COLLECTION=product_views
MONGO_URI=mongodb://kafka_app:local-app-password@localhost:27017/kafka_db?authSource=kafka_db

# =================
# APP
# =================
LOG_LEVEL=INFO
KAFKA_DELIVERY_TIMEOUT_SECONDS=30

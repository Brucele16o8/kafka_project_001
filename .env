# ===========================
# SOURCE KAFKA A
# ===========================
SOURCE_SYSTEM_ID=provided-kafka-a
SOURCE_KAFKA_BOOTSTRAP_SERVERS=46.202.167.130:9094
SOURCE_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
SOURCE_KAFKA_SASL_MECHANISM=PLAIN
SOURCE_KAFKA_USERNAME=kafka
SOURCE_KAFKA_PASSWORD="UnigapKafka@2024"
SOURCE_TOPIC=product_view
SOURCE_GROUP_ID=product-view-relay-bruce
